#!/usr/bin/env bash
# Deploy skill and adapter symlinks to installed agent harnesses.
set -euo pipefail

VERBOSE=0
AUTO_YES=0
HERMES_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--verbose) VERBOSE=1 ; shift ;;
    -y|--yes) AUTO_YES=1 ; shift ;;
    --harness=hermes) HERMES_ONLY=1 ; shift ;;
    --harness)
      shift
      if [ $# -gt 0 ] && [ "$1" = "hermes" ]; then
        HERMES_ONLY=1
        shift
      fi
      ;;
    -h|--help)
      cat <<'EOF'
Usage: ./apply [-y] [-v] [--harness hermes]

  -y, --yes      Non-interactive: enable all skills and deploy
  -v, --verbose  Verbose logging
  --harness NAME Deploy only to a specific harness (e.g. hermes)
  -h, --help     Show help

Targets (if present): ~/.agents, ~/.codex, ~/.gemini/config, ~/.cursor, ~/.claude,
  ~/.copilot, ~/.kiro, ~/.config/opencode, ~/.antigravity, ~/.augment,
  ~/.continue, ~/.roo, ~/.hermes
EOF
      exit 0
      ;;
    *) shift ;;
  esac
done

repo_dir="$(cd "$(dirname "$0")" && pwd)"
cd "$repo_dir"

skills=()
descriptions=()
paths=()
enabled=()

# Frontmatter helpers (name / description may be multiline with >-)
frontmatter_field() {
  local file="$1" field="$2"
  awk -v f="$field" '
    BEGIN { in_fm=0; grab=0; val="" }
    /^---[[:space:]]*$/ {
      if (in_fm==0) { in_fm=1; next }
      else { exit }
    }
    in_fm && $0 ~ ("^" f ":") {
      line=$0
      sub("^[^:]+:[[:space:]]*", "", line)
      if (line == ">" || line == ">-") { grab=1; next }
      print line
      exit
    }
    grab {
      if ($0 ~ /^[a-zA-Z0-9_-]+:/) { exit }
      gsub(/^[[:space:]]+/, "")
      print
      exit
    }
  ' "$file" | head -1 | tr -d '"' | sed "s/^[[:space:]]*//;s/[[:space:]]*$//;s/^'//;s/'$//"
}

for dir in skills/*/; do
  [ -f "${dir}SKILL.md" ] || continue
  name="$(frontmatter_field "${dir}SKILL.md" name)"
  [ -z "$name" ] && name="$(basename "$dir")"
  desc="$(frontmatter_field "${dir}SKILL.md" description)"
  skills+=("$name")
  descriptions+=("$desc")
  paths+=("$(cd "$dir" && pwd)")
  enabled+=(1)
done

if [ ${#skills[@]} -eq 0 ]; then
  echo "No skills found in skills/ directory."
  exit 0
fi

# Known retired aliases / old folder names — purge from targets safely
STALE_ALIASES=(
  code-yagni
  developer-context-profile
  hackathon-idea-generator
  idea-consultant
  momentum-engine
  spec-builder
  speckit
  speckit-analyze
  speckit-checklist
  speckit-clarify
  speckit-constitution
  speckit-implement
  speckit-plan
  speckit-specify
  speckit-tasks
  speckit-taskstoissues
  thinking-partner
  token-compressor
  mail-organizer
  git_signed_commit
)

if [ "$AUTO_YES" -eq 0 ]; then
  while true; do
    clear 2>/dev/null || true
    echo -e "\033[1;36m✨ Skill Installer ✨\033[0m"
    echo "---------------------------------"
    echo "Toggle skills to enable (default: all on):"
    echo

    for i in "${!skills[@]}"; do
      status="[ ]"
      if [ "${enabled[$i]}" -eq 1 ]; then
        status="[\033[1;32m✓\033[0m]"
      fi
      echo -e " $status  $((i+1)). \033[1m${skills[$i]}\033[0m"
      if [ -n "${descriptions[$i]}" ]; then
        echo -e "        \033[3m${descriptions[$i]}\033[0m"
      fi
      echo
    done

    echo "Commands: [number] toggle | a all | n none | y/Enter confirm | q quit"
    echo
    read -r -p "Action [number/a/n/y/q]: " action || true
    action="$(echo "$action" | tr -d '[:space:]')"

    if [ "$action" = "q" ]; then
      echo "Exiting without making changes."
      exit 0
    fi
    if [ "$action" = "y" ] || [ -z "$action" ]; then
      break
    fi
    if [ "$action" = "a" ]; then
      for i in "${!skills[@]}"; do enabled[$i]=1; done
      continue
    fi
    if [ "$action" = "n" ]; then
      for i in "${!skills[@]}"; do enabled[$i]=0; done
      continue
    fi
    if [[ "$action" =~ ^[0-9]+$ ]] && [ "$action" -ge 1 ] && [ "$action" -le ${#skills[@]} ]; then
      idx=$((action - 1))
      if [ "${enabled[$idx]}" -eq 1 ]; then enabled[$idx]=0; else enabled[$idx]=1; fi
    else
      read -r -p "Invalid option. Press Enter to try again." _
    fi
  done
else
  echo "Non-interactive: enabling all ${#skills[@]} skills."
fi

# Install only repository-owned links for other harnesses. Matching names alone never imply ownership.
python3 - "$repo_dir" "${skills[@]}" -- "${enabled[@]}" --paths "${paths[@]}" "$HERMES_ONLY" <<'PY'
import json
import os
from pathlib import Path
import shutil
import sys
import tempfile

repo = Path(sys.argv[1]).resolve()
args = sys.argv[2:]
cut = args.index("--")
path_cut = args.index("--paths")
names = args[:cut]
enabled = args[cut + 1:path_cut]
source_paths = [Path(p).resolve() for p in args[path_cut + 1:-1]]
hermes_only = args[-1] == "1"
skills = dict(zip(names, source_paths))
selected = {name for name, flag in zip(names, enabled) if flag == "1"}
home = Path.home()


def exists(path):
    return os.path.lexists(path)


def owned_link(path):
    if not path.is_symlink():
        return False
    # Resolve the link text lexically, so broken foreign links are never deleted.
    target = Path(os.path.abspath(path.parent / os.readlink(path)))
    return target == repo or repo in target.parents


def safe_link(source, destination):
    if exists(destination):
        if not owned_link(destination):
            print(f"  preserve: {destination}")
            return False
        if destination.resolve() == source.resolve():
            return True
        destination.unlink()
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(os.path.relpath(source, destination.parent))
    return True


def install_hermes():
    # Hermes uses portable copies: references remain relative and the install works
    # after this repository moves to another device. The manifest owns directories,
    # never arbitrary files or symlinks that happen to share a skill name.
    hermes = Path(os.environ.get("HERMES_HOME", home / ".hermes")).expanduser()
    skill_root = hermes / "skills"
    if skill_root.is_symlink():
        print(f"  preserve symlinked skills root: {skill_root}")
        return
    skill_root.mkdir(parents=True, exist_ok=True)
    manifest_path = skill_root / ".skills-apply-manifest.json"
    try:
        old = json.loads(manifest_path.read_text())
        old_names = set(old.get("skills", []))
    except (FileNotFoundError, ValueError, OSError):
        old_names = set()
    for name in old_names - selected:
        stale = skill_root / name
        if stale.is_dir() and not stale.is_symlink():
            shutil.rmtree(stale)
    installed = []
    for name in sorted(selected):
        source = skills[name]
        destination = skill_root / name
        if exists(destination) and name not in old_names:
            print(f"  preserve: {destination}")
            continue
        if exists(destination):
            if destination.is_symlink():
                print(f"  preserve symlink: {destination}")
                continue
            if not destination.is_dir():
                print(f"  preserve: {destination}")
                continue
            shutil.rmtree(destination)
        with tempfile.TemporaryDirectory(dir=skill_root) as staging:
            staged = Path(staging) / name
            shutil.copytree(source, staged, symlinks=True)
            os.replace(staged, destination)
        installed.append(name)
    manifest = {"format": 1, "skills": installed}
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(f"✓ Installed {len(installed)} copied skills → {hermes}")


if hermes_only:
    install_hermes()
else:
    locations = {"agents": home / ".agents", "codex": home / ".codex",
                 "gemini": home / ".gemini/config", "cursor": home / ".cursor",
                 "claude": home / ".claude", "copilot": home / ".copilot",
                 "kiro": home / ".kiro", "opencode": home / ".config/opencode",
                 "antigravity": home / ".antigravity", "augment": home / ".augment",
                 "continue": home / ".continue", "roo": home / ".roo"}
    for harness, target in locations.items():
        if harness != "agents" and not target.is_dir():
            continue
        folder = target / "skills"
        if folder.is_symlink():
            print(f"  preserve symlinked skills root: {folder}")
            continue
        folder.mkdir(parents=True, exist_ok=True)
        for entry in folder.iterdir():
            if owned_link(entry) and entry.name not in selected:
                entry.unlink()
        for name in sorted(selected):
            safe_link(skills[name], folder / name)
        if harness != "claude":
            for filename in ("AGENTS.md", "harness-context.md"):
                if (repo / filename).is_file():
                    safe_link(repo / filename, target / filename)
        if harness == "cursor" and (repo / "agents/context-health.md").is_file():
            folder = target / "agents"
            if not folder.is_symlink():
                folder.mkdir(exist_ok=True)
                safe_link(repo / "agents/context-health.md", folder / "context-health.md")
        if harness in ("gemini", "antigravity") and (repo / "GEMINI.md").is_file():
            destination = target.parent / "GEMINI.md" if harness == "gemini" else target / "GEMINI.md"
            safe_link(repo / "GEMINI.md", destination)
        print(f"✓ Installed skills → {target}")
PY

echo "Deploy complete."
